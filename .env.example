APP_ENV=local
APP_NAME=blandskron-rag-services
LOG_LEVEL=INFO
CORS_ORIGINS=["*"]

DATABASE_URL=postgresql+psycopg://postgres:admin1234@localhost:5432/documents_db

# Docker compose overrides DATABASE_URL for container networking.
# Optional local database role passwords.
# CONVERSATION_DB_PASSWORD=blandskron-local-conversation
# RAG_CHAT_DB_PASSWORD=blandskron-local-rag-chat
# pgAdmin: http://localhost:5050
# pgAdmin login: admin@example.com / admin1234

# Groq Chat
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
CHAT_COMPLETION_MAX_TOKENS=2000
CHAT_COMPLETION_TEMPERATURE=0.3
CHAT_COMPLETION_TIMEOUT_SECONDS=60

DOCUMENT_STORAGE_BASE_PATH=./documents
EXPORT_STORAGE_BASE_PATH=./documents/exports
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/documents
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.file
GOOGLE_TOKEN_ENCRYPTION_KEY=change-me-with-a-long-random-secret
MAX_CHUNK_SIZE=1200
CHUNK_OVERLAP=160
VECTOR_SEARCH_LIMIT=5
MIN_SIMILARITY_SCORE=0.0

VITE_AUTH_BASE_URL=http://localhost:8001
VITE_RAG_CHAT_BASE_URL=http://localhost:8002
VITE_RAG_DOCUMENT_BASE_URL=http://localhost:8003
VITE_DOCUMENT_SEARCH_BASE_URL=http://localhost:8004
VITE_DOCUMENT_ACCESS_BASE_URL=http://localhost:8005
VITE_DOCUMENT_LIBRARY_BASE_URL=http://localhost:8006
VITE_DOCUMENT_TRANSFER_BASE_URL=http://localhost:8007
VITE_DOCUMENT_EXPORT_BASE_URL=http://localhost:8016
VITE_GOOGLE_DRIVE_IMPORT_BASE_URL=http://localhost:8017
VITE_CONVERSATION_BASE_URL=http://localhost:8008
VITE_PROFILE_BASE_URL=http://localhost:8015
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PICKER_APP_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# AuthServices JWT validation.
# Docker overrides this path to /app/auth_keys/public.pem.
# For local execution, run AuthServices first so Django generates this key pair.
AUTH_JWT_PUBLIC_KEY_PATH=./backend/AuthServices/public.pem
AUTH_JWT_ALGORITHM=RS256
