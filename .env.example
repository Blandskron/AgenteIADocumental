APP_ENV=local
APP_NAME=blandskron-rag-services
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Required for a new local installation. Choose your own secrets; no usable defaults.
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_EMAIL=
# Only for direct (non-Compose) execution; use the appropriate runtime role.
DATABASE_URL=

# Docker compose overrides DATABASE_URL for container networking.
# Optional local database role passwords.
# CONVERSATION_DB_PASSWORD=blandskron-local-conversation
# RAG_CHAT_DB_PASSWORD=blandskron-local-rag-chat
# SEARCH_DB_PASSWORD=blandskron-local-search
# EMBEDDING_DB_PASSWORD=blandskron-local-embedding
# On Linux, set these to the non-root owner of the shared documents directory.
# EMBEDDING_UID=10004
# EMBEDDING_GID=10004
# Optional tools profile: configure these only when starting pgadmin.
# PGADMIN_DEFAULT_EMAIL=admin@example.invalid
# PGADMIN_DEFAULT_PASSWORD=

# Groq Chat
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
CHAT_COMPLETION_MAX_TOKENS=2000
CHAT_COMPLETION_TEMPERATURE=0.3
CHAT_COMPLETION_TIMEOUT_SECONDS=60

DOCUMENT_STORAGE_BASE_PATH=./documents
EXPORT_STORAGE_BASE_PATH=./documents/exports
# Drive remains optional. Use independent secrets only when enabling it.
GOOGLE_DRIVE_ENABLED=false
DRIVE_DB_PASSWORD=blandskron-local-drive
DRIVE_DB_POOL_MIN_SIZE=1
DRIVE_DB_POOL_MAX_SIZE=10
DRIVE_DB_TIMEOUT_SECONDS=30
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/documents
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.file
# Versioned key ring: inject real secrets through your deployment secret store.
GOOGLE_TOKEN_KEY_ID=v1
GOOGLE_TOKEN_PREVIOUS_KEYS={}
GOOGLE_TOKEN_LEGACY_KEY_ID=
GOOGLE_PICKER_APP_ID=
GOOGLE_TOKEN_ENCRYPTION_KEY=change-me-with-a-long-random-secret
MAX_CHUNK_SIZE=1200
CHUNK_OVERLAP=160
VECTOR_SEARCH_LIMIT=5
MIN_SIMILARITY_SCORE=0.0

VITE_AUTH_BASE_URL=http://localhost:8001
VITE_RAG_CHAT_BASE_URL=http://localhost:8002
VITE_RAG_DOCUMENT_BASE_URL=http://localhost:8003
VITE_DOCUMENT_SEARCH_BASE_URL=http://localhost:8004
VITE_DOCUMENT_ACCESS_BASE_URL=http://localhost:8005
VITE_DOCUMENT_LIBRARY_BASE_URL=http://localhost:8006
VITE_DOCUMENT_TRANSFER_BASE_URL=http://localhost:8007
VITE_DOCUMENT_EXPORT_BASE_URL=http://localhost:8016
VITE_GOOGLE_DRIVE_IMPORT_BASE_URL=http://localhost:8017
VITE_CONVERSATION_BASE_URL=http://localhost:8008
VITE_PROFILE_BASE_URL=http://localhost:8015
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=
VITE_GOOGLE_PICKER_APP_ID=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PICKER_API_KEY=
GOOGLE_PICKER_APP_ID=

# AuthServices JWT validation.
# Docker overrides this path to /app/auth_keys/public.pem.
# For local execution, run AuthServices first so Django generates this key pair.
AUTH_JWT_PUBLIC_KEY_PATH=./backend/AuthServices/public.pem
AUTH_JWT_ALGORITHM=RS256

# DocumentAccessServices comparte el propietario del volumen de ingesta en Linux.
# ACCESS_DB_PASSWORD=blandskron-local-access
# LIBRARY_DB_PASSWORD=blandskron-local-library
# ACCESS_UID=10004
# ACCESS_GID=10004

# DocumentLibraryServices
# LIBRARY_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# LIBRARY_DB_POOL_MIN_SIZE=1
# LIBRARY_DB_POOL_MAX_SIZE=10
# LIBRARY_DB_TIMEOUT_SECONDS=30

# Transfer: entorno explícito; no recibe las claves de IA/OAuth del archivo global.
# TRANSFER_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# TRANSFER_DB_POOL_MIN_SIZE=1
# TRANSFER_DB_POOL_MAX_SIZE=10
# TRANSFER_DB_TIMEOUT_SECONDS=30
# TRANSFER_DB_PASSWORD=blandskron-local-transfer

# Profile: configuración explícita y rol profile_runtime.
# PROFILE_DB_PASSWORD=blandskron-local-profile
# PROFILE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# PROFILE_DB_POOL_MIN_SIZE=1
# PROFILE_DB_POOL_MAX_SIZE=10
# PROFILE_DB_TIMEOUT_SECONDS=30

# Export: entorno explícito y rol PostgreSQL mínimo export_runtime.
# EXPORT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# EXPORT_DB_POOL_MIN_SIZE=1
# EXPORT_DB_POOL_MAX_SIZE=10
# EXPORT_DB_TIMEOUT_SECONDS=30

# Export runtime role (development default; inject a distinct secret in deployed environments).
EXPORT_DB_PASSWORD=blandskron-local-export
